; Engine configuration file.
; Block Rift Runner uses the Mobile renderer for Vulkan on Android.

config_version=5

[application]

config/name="Block Rift Runner"
run/main_scene="res://scenes/main.tscn"
config/description="A low-poly procedural space-flight arcade game."
config/version="0.1.0"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.055, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

